<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Pulse</title>
    <organization>com.MarkHammond</organization>
    <!-- Both domains enabled, so Installer shows a Destination Select pane.
         Choosing "for me only" rewrites each absolute install-location relative
         to the user's home, so /Library/Audio/Plug-Ins/... becomes
         ~/Library/Audio/Plug-Ins/... and /Applications becomes ~/Applications.
         Installing for all users still needs an admin password; installing for
         the current user only does not. -->
    <domains enable_currentUserHome="true" enable_localSystem="true"/>
    <options hostArchitectures="arm64,x86_64"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="standalone"/>
    </choices-outline>
    <choice id="vst3" title="VST3" description="VST3 plugin format">
        <pkg-ref id="com.MarkHammond.Pulse.vst3.pkg"/>
    </choice>
    <choice id="au" title="Audio Unit" description="Audio Unit plugin format">
        <pkg-ref id="com.MarkHammond.Pulse.au.pkg"/>
    </choice>
    <choice id="standalone" title="Standalone App" description="Standalone application">
        <pkg-ref id="com.MarkHammond.Pulse.app.pkg"/>
    </choice>
    <pkg-ref id="com.MarkHammond.Pulse.vst3.pkg" version="VERSION_PLACEHOLDER" onConclusion="none">Pulse.vst3.pkg</pkg-ref>
    <pkg-ref id="com.MarkHammond.Pulse.au.pkg" version="VERSION_PLACEHOLDER" onConclusion="none">Pulse.au.pkg</pkg-ref>
    <pkg-ref id="com.MarkHammond.Pulse.app.pkg" version="VERSION_PLACEHOLDER" onConclusion="none">Pulse.app.pkg</pkg-ref>
</installer-gui-script>
