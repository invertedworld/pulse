<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Pulse</title>
    <organization>com.MarkHammond</organization>
    <!-- System folders only. Pro Tools looks for AAX plugins in /Library and
         nowhere else, so a "for me only" install would leave the AAX unseen. -->
    <domains enable_localSystem="true"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <choices-outline>
        <line choice="au"/>
        <line choice="vst3"/>
        <line choice="aax"/>
    </choices-outline>
    <choice id="au" title="Audio Unit" description="For Logic Pro, GarageBand and other hosts that use Audio Units. Installed for all users.">
        <pkg-ref id="com.MarkHammond.Pulse.au.pkg"/>
    </choice>
    <choice id="vst3" title="VST3" description="For Ableton Live, Cubase, Reaper, Bitwig, Studio One and other hosts that use VST3. Installed for all users.">
        <pkg-ref id="com.MarkHammond.Pulse.vst3.pkg"/>
    </choice>
    <choice id="aax" title="AAX" description="For Pro Tools. Installed for all users.">
        <pkg-ref id="com.MarkHammond.Pulse.aax.pkg"/>
    </choice>
    <pkg-ref id="com.MarkHammond.Pulse.au.pkg" version="VERSION_PLACEHOLDER" onConclusion="none">Pulse.au.pkg</pkg-ref>
    <pkg-ref id="com.MarkHammond.Pulse.vst3.pkg" version="VERSION_PLACEHOLDER" onConclusion="none">Pulse.vst3.pkg</pkg-ref>
    <pkg-ref id="com.MarkHammond.Pulse.aax.pkg" version="VERSION_PLACEHOLDER" onConclusion="none">Pulse.aax.pkg</pkg-ref>
</installer-gui-script>
